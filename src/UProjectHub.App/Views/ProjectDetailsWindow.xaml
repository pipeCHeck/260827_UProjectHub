<Window x:Class="UProjectHub.App.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UProjectHub.App.Behaviors"
        Title="{DynamicResource String.ProjectDetails}"
        Width="700"
        Height="580"
        MinWidth="520"
        MinHeight="420"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Opacity="0"
        behaviors:MotionFeedbackBehavior.Duration="{DynamicResource Motion.SlowDuration}"
        behaviors:MotionFeedbackBehavior.EasingFunction="{DynamicResource Motion.EaseOut}"
        behaviors:MotionFeedbackBehavior.IsOpacityFeedbackEnabled="True"
        behaviors:MotionFeedbackBehavior.RestingOpacity="0"
        behaviors:MotionFeedbackBehavior.ActiveOpacity="1"
        behaviors:MotionFeedbackBehavior.IsOpacityFeedbackActive="{Binding IsVisible, RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{DynamicResource Text.DialogTitle}"
                   Text="{Binding Name}"
                   TextTrimming="CharacterEllipsis" />

        <TabControl x:Name="DetailsTabControl"
                    Grid.Row="1"
                    Margin="{DynamicResource Thickness.DialogSectionGap}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=OneTime}"
                    Background="{DynamicResource Brush.Transparent}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    Foreground="{DynamicResource Brush.TextPrimary}">
            <TabItem Header="{DynamicResource String.Overview}">
                <ScrollViewer x:Name="OverviewScrollViewer"
                              Padding="{DynamicResource Thickness.DetailsTabContent}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid DataContext="{Binding Overview}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{DynamicResource String.ProjectFile}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectPath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.Directory}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding ProjectDirectory}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.EngineAssociation}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding EngineAssociation}" />
                        <TextBlock Grid.Row="3" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.EngineVersion}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding EngineDisplayVersion}" />
                        <TextBlock Grid.Row="4" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.ProjectType}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding ProjectType}" />
                        <TextBlock Grid.Row="5" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.ProjectState}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding ProjectState}" />
                        <TextBlock Grid.Row="6" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.EngineState}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding EngineState}" />
                        <TextBlock Grid.Row="7" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.Favorite}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding FavoriteDisplay}" />
                        <TextBlock Grid.Row="8" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.LastModified}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding LastModified}" />
                        <TextBlock Grid.Row="9" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.LastLaunched}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding LastLaunched}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource String.Diagnostics}">
                <ScrollViewer x:Name="DiagnosticsScrollViewer"
                              Padding="{DynamicResource Thickness.DetailsTabContent}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding Diagnostics}">
                        <TextBlock Margin="{DynamicResource Thickness.DetailsDescriptionGap}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{DynamicResource String.DiagnosticsDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding EmptyMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoFindings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{DynamicResource Thickness.DiagnosticItemGap}"
                                            Padding="{DynamicResource Thickness.DiagnosticItemPadding}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadius.Control}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.InfoSurface}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSurface}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding SeverityLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="{DynamicResource Thickness.DiagnosticMessageGap}"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="{DynamicResource Thickness.DiagnosticActionGap}"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SuggestedActionLabel}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasSuggestedAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource String.TagsAndNotes}">
                <ScrollViewer x:Name="TagsNotesScrollViewer"
                              Padding="{DynamicResource Thickness.DetailsTabContent}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding Notes}">
                        <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                   Text="{DynamicResource String.Tags}" />
                        <TextBlock Margin="{DynamicResource Thickness.DetailsFieldGap}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{DynamicResource String.TagsDescription}"
                                   TextWrapping="Wrap" />
                        <ItemsControl Margin="{DynamicResource Thickness.DetailsFieldGap}"
                                      ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{DynamicResource Thickness.TagChipMargin}"
                                            Padding="{DynamicResource Thickness.TagBadgePadding}"
                                            Background="{DynamicResource Brush.AccentSubtle}"
                                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadius.Small}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Text="{Binding}" />
                                            <Button Margin="8,0,0,0"
                                                    MinWidth="24"
                                                    Padding="3,0"
                                                    Style="{DynamicResource Button.Icon}"
                                                    Command="{Binding DataContext.Notes.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    ToolTip="{DynamicResource String.RemoveTag}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="{DynamicResource Thickness.DetailsFieldGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TagInputComboBox"
                                      MinWidth="220"
                                      Height="{DynamicResource Metric.DetailsInputHeight}"
                                      Style="{DynamicResource ComboBox.Editable}"
                                      ItemsSource="{Binding TagSuggestions}"
                                      Text="{Binding NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding SelectedTagSuggestion, Mode=TwoWay}"
                                      IsDropDownOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Margin="{DynamicResource Thickness.DetailsActionGap}"
                                    MinWidth="88"
                                    Command="{Binding AddTagCommand}"
                                    Content="{DynamicResource String.AddTag}" />
                        </Grid>
                        <TextBlock Margin="{DynamicResource Thickness.DetailsFieldGap}"
                                   Text="{Binding TagStatusMessage}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTagError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="{DynamicResource Thickness.NotesSectionGap}"
                                   Style="{DynamicResource Text.SectionTitle}"
                                   Text="{DynamicResource String.Note}" />
                        <TextBlock Margin="{DynamicResource Thickness.DetailsFieldGap}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{DynamicResource String.NoteExplicitSaveDescription}"
                                   TextWrapping="Wrap" />
                        <TextBox Margin="{DynamicResource Thickness.DetailsFieldGap}"
                                 MinHeight="160"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel Margin="{DynamicResource Thickness.DetailsFieldGap}">
                            <Button DockPanel.Dock="Right"
                                    MinWidth="88"
                                    Command="{Binding SaveNoteCommand}"
                                    Content="{DynamicResource String.SaveNote}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource Brush.WarningText}"
                                           Text="{DynamicResource String.UnsavedChanges}"
                                           Visibility="{Binding IsNoteDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="{Binding NoteStatusMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoteError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                MinWidth="88"
                HorizontalAlignment="Right"
                IsCancel="True"
                Content="{DynamicResource String.Close}" />
    </Grid>
</Window>
