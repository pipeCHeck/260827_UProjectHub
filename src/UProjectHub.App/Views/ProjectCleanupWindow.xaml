<Window x:Class="UProjectHub.App.Views.ProjectCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource String.ProjectCleanup}"
        Width="780"
        Height="700"
        MinWidth="600"
        MinHeight="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{DynamicResource Text.DialogTitle}"
                       Text="{DynamicResource String.ProjectCleanup}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{DynamicResource String.ProjectCleanupDescription}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding ProjectPath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProjectPath}" />
        </StackPanel>

        <ScrollViewer x:Name="CleanupScrollViewer"
                      Grid.Row="1"
                      Margin="{DynamicResource Thickness.DialogSectionGap}"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfirmationVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ProgressBar Height="4"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsInspecting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl x:Name="CleanupItemsControl"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadius.Surface}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Margin="0,1,12,0"
                                                  VerticalAlignment="Top"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding Path, TargetNullValue=No unique path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Text="{Binding AvailabilityText}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Brush.WarningText}"
                                                           Text="{Binding DetailText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding ResultText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding SizeText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,4,0,0"
                            Padding="12"
                            Background="{DynamicResource Brush.WarningSurface}"
                            CornerRadius="{DynamicResource CornerRadius.Surface}"
                            Visibility="{Binding ShowBinariesWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource Brush.WarningText}"
                                   Text="{DynamicResource String.ProjectCleanupBinariesWarning}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="0,8,0,0"
                            Padding="12"
                            Background="{DynamicResource Brush.InfoSurface}"
                            CornerRadius="{DynamicResource CornerRadius.Surface}"
                            Visibility="{Binding ShowSolutionInformation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource Brush.InfoText}"
                                   Text="{DynamicResource String.ProjectCleanupSolutionInfo}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Padding="14"
                            Background="{DynamicResource Brush.WarningSurface}"
                            CornerRadius="{DynamicResource CornerRadius.Surface}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.WarningText}"
                                       Text="{DynamicResource String.ProjectCleanupConfirmTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource Brush.WarningText}"
                                       Text="{DynamicResource String.ProjectCleanupConfirmDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Path}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{DynamicResource String.ProjectCleanupSelectedSize}" />
                        <TextBlock Margin="4,0,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedSizeText}" />
                    </StackPanel>
                    <ProgressBar Margin="0,16,0,0"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsCleaning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88"
                        IsCancel="True"
                        IsEnabled="{Binding CanClose}"
                        Content="{DynamicResource String.Close}" />
                <Button MinWidth="88"
                        Margin="8,0,0,0"
                        Command="{Binding CancelConfirmationCommand}"
                        Content="{DynamicResource String.Back}"
                        Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button MinWidth="112"
                        Margin="8,0,0,0"
                        Command="{Binding BeginConfirmationCommand}"
                        Content="{DynamicResource String.ReviewCleanup}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfirmationVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button MinWidth="124"
                        Margin="8,0,0,0"
                        Command="{Binding ConfirmCleanupCommand}"
                        Content="{DynamicResource String.ConfirmCleanup}"
                        Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
