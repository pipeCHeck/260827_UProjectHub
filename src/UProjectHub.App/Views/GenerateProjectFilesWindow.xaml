<Window x:Class="UProjectHub.App.Views.GenerateProjectFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource String.GenerateProjectFiles}"
        Icon="/UProjectHub.App;component/Assets/UProjectHub.ico"
        Width="760"
        Height="660"
        MinWidth="620"
        MinHeight="540"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{DynamicResource Text.DialogTitle}"
                       Text="{DynamicResource String.GenerateProjectFiles}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{DynamicResource String.GenerateProjectFilesDescription}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="{DynamicResource Thickness.DialogSectionGap}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="12"
                        Background="{DynamicResource Brush.WarningSurface}"
                        CornerRadius="{DynamicResource CornerRadius.Surface}">
                    <TextBlock Foreground="{DynamicResource Brush.WarningText}"
                               Text="{DynamicResource String.GenerateProjectFilesMutationWarning}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource String.Project}" />
                    <TextBlock Grid.Column="1" Text="{Binding ProjectName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.ProjectFile}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding ProjectPath}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.EngineVersion}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding EngineDisplayName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.EngineRoot}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding EngineRoot}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Margin="{DynamicResource Thickness.DialogRowGap}" FontWeight="SemiBold" Text="{DynamicResource String.ExpectedSolution}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="{DynamicResource Thickness.DialogRowGap}" Text="{Binding ExpectedSolutionPath}" TextWrapping="Wrap" />
                </Grid>

                <ProgressBar Margin="0,18,0,0"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="OutputDetailsTextBox"
                         Margin="0,12,0,0"
                         MinHeight="120"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         Text="{Binding OutputDetails, Mode=OneWay}"
                         TextChanged="OutputDetailsTextBox_OnTextChanged"
                         ScrollViewer.ScrollChanged="OutputDetailsTextBox_OnScrollChanged"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasOutputDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource String.Cancel}" />
            <Button MinWidth="88"
                    Margin="8,0,0,0"
                    Command="{Binding GenerateCommand}"
                    Content="{DynamicResource String.Generate}" />
            <Button MinWidth="88"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    IsEnabled="{Binding CanClose}"
                    Content="{DynamicResource String.Close}" />
        </StackPanel>
    </Grid>
</Window>
