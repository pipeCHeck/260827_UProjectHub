<Window x:Class="UProjectHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UProjectHub.App.Behaviors"
        xmlns:infrastructure="clr-namespace:UProjectHub.App.Infrastructure"
        Title="{DynamicResource String.Settings}"
        Icon="/UProjectHub.App;component/Assets/UProjectHub.ico"
        Width="720"
        Height="740"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinWidth="600"
        MinHeight="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Grid Margin="{DynamicResource Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{DynamicResource Text.DialogTitle}"
                   Text="{DynamicResource String.Settings}" />

        <ScrollViewer Grid.Row="1"
                      Margin="{DynamicResource Thickness.DialogSectionGap}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.EmptyTitle}"
                           Text="{DynamicResource String.Projects}" />
                <TextBlock Margin="{DynamicResource Thickness.DialogRowGap}"
                           Style="{DynamicResource Text.Body}"
                           Text="{DynamicResource String.SearchLocations}" />
                <Border Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.Surface}"
                        behaviors:FolderDropBehavior.Command="{Binding AddDroppedSearchRootsCommand}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox MinHeight="72"
                                 ItemsSource="{Binding SearchRoots}"
                                 SelectedItem="{Binding SelectedSearchRoot, Mode=TwoWay}"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="6,4"
                                               Style="{DynamicResource Text.Body}"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddSearchRootCommand}"
                                    Content="{DynamicResource String.AddSearchRoot}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RemoveSearchRootCommand}"
                                    Content="{DynamicResource String.Remove}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RescanCommand}"
                                    Content="{DynamicResource String.RescanProjects}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Style="{DynamicResource Text.EmptyTitle}"
                           Text="{DynamicResource String.ManualEngines}" />
                <TextBlock x:Name="ManualEngineRootHintText"
                           Margin="0,6,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="{DynamicResource String.ManualEngineRootHint}"
                           TextWrapping="Wrap" />
                <Border Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox MinHeight="60"
                                 ItemsSource="{Binding ManualEngineRoots}"
                                 SelectedItem="{Binding SelectedManualEngineRoot, Mode=TwoWay}"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="6,4"
                                               Style="{DynamicResource Text.Body}"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddManualEngineCommand}"
                                    Content="{DynamicResource String.AddEngineRoot}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RemoveManualEngineCommand}"
                                    Content="{DynamicResource String.Remove}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Style="{DynamicResource Text.EmptyTitle}"
                           Text="{DynamicResource String.Appearance}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{DynamicResource String.Theme}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ThemeOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedThemeMode, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Margin="0,10,16,0" VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{DynamicResource String.RowDensity}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                              ItemsSource="{Binding RowDensityOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedRowDensity, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Margin="0,10,16,0" VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{DynamicResource String.Language}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{x:Static infrastructure:AppVersion.Display}" />
            <TextBlock Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{Binding StatusText}" />
            <Button Grid.Column="2"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Command="{Binding SaveAppearanceCommand}"
                    Content="{DynamicResource String.Apply}" />
            <Button Grid.Column="3"
                    MinWidth="80"
                    IsCancel="True"
                    Content="{DynamicResource String.Close}" />
        </Grid>
    </Grid>
</Window>
