<Window x:Class="UProjectHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UProjectHub.App.Behaviors"
        Title="Settings"
        Width="720"
        Height="680"
        MinWidth="600"
        MinHeight="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Grid Margin="{DynamicResource Thickness.DialogContent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{DynamicResource Text.DialogTitle}"
                   Text="Settings" />

        <ScrollViewer Grid.Row="1"
                      Margin="{DynamicResource Thickness.DialogSectionGap}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.EmptyTitle}"
                           Text="Projects" />
                <TextBlock Margin="{DynamicResource Thickness.DialogRowGap}"
                           Style="{DynamicResource Text.Body}"
                           Text="Search locations" />
                <Border Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.Surface}"
                        behaviors:FolderDropBehavior.Command="{Binding AddDroppedSearchRootsCommand}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox MinHeight="92"
                                 ItemsSource="{Binding SearchRoots}"
                                 SelectedItem="{Binding SelectedSearchRoot, Mode=TwoWay}"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="6,4"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddSearchRootCommand}"
                                    Content="+ Add search root" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RemoveSearchRootCommand}"
                                    Content="Remove" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RescanCommand}"
                                    Content="Rescan projects" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,20,0,0"
                           Style="{DynamicResource Text.EmptyTitle}"
                           Text="Manual Unreal Engines" />
                <Border Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadius.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox MinHeight="76"
                                 ItemsSource="{Binding ManualEngineRoots}"
                                 SelectedItem="{Binding SelectedManualEngineRoot, Mode=TwoWay}"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="6,4"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddManualEngineCommand}"
                                    Content="+ Add engine root" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding RemoveManualEngineCommand}"
                                    Content="Remove" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,20,0,0"
                           Style="{DynamicResource Text.EmptyTitle}"
                           Text="Appearance" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="Theme" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Margin="0,10,16,0" VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="Row density" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                              ItemsSource="{Binding RowDensities}"
                              SelectedItem="{Binding SelectedRowDensity, Mode=TwoWay}" />
                    <Button Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SaveAppearanceCommand}"
                            Content="Apply appearance" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{Binding StatusText}" />
            <Button Grid.Column="1"
                    MinWidth="80"
                    IsCancel="True"
                    Content="Close" />
        </Grid>
    </Grid>
</Window>
