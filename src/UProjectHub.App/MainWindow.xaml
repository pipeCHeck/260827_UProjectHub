<Window x:Class="UProjectHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UProjectHub.App.Controls"
        Title="{Binding Title}"
        Width="1120"
        Height="700"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding ProjectCountText}" />
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="88"
                    Padding="14,7"
                    VerticalAlignment="Top"
                    Command="{Binding SettingsCommand}"
                    Content="Settings" />
        </Grid>

        <controls:ProjectList Grid.Row="1"
                              Margin="24,8,24,16"
                              DataContext="{Binding ProjectList}" />

        <Border Grid.Row="2"
                Padding="24,10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding StatusBar.StatusText}" />
                <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{Binding ProjectList.ShowingCountText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
