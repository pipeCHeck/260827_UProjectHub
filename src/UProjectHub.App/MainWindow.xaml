<Window x:Class="UProjectHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UProjectHub.App.Controls"
        Title="{Binding Title}"
        Width="1120"
        Height="700"
        MinWidth="800"
        MinHeight="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="{DynamicResource Thickness.WindowHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="{Binding ProjectCountText}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button MinWidth="88"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
                <Button MinWidth="88"
                        Margin="{DynamicResource Thickness.ChipGap}"
                        Command="{Binding SettingsCommand}"
                        Content="Settings" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="{DynamicResource Thickness.ToolbarMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:SearchBox x:Name="ProjectSearchBox"
                                Text="{Binding SearchFilter.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ClearCommand="{Binding SearchFilter.ClearSearchCommand}" />

            <StackPanel Grid.Row="1"
                        Margin="{DynamicResource Thickness.SectionTopGap}"
                        Orientation="Horizontal">
                <controls:FilterChip Label="Engine">
                    <controls:FilterChip.ChipContent>
                        <ComboBox Width="160"
                                  ItemsSource="{Binding SearchFilter.EngineFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SearchFilter.SelectedEngine, Mode=TwoWay}" />
                    </controls:FilterChip.ChipContent>
                </controls:FilterChip>

                <controls:FilterChip Margin="{DynamicResource Thickness.ChipGap}"
                                     Label="Type">
                    <controls:FilterChip.ChipContent>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding SearchFilter.ProjectTypeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SearchFilter.SelectedProjectType, Mode=TwoWay}" />
                    </controls:FilterChip.ChipContent>
                </controls:FilterChip>

                <controls:FilterChip Margin="{DynamicResource Thickness.ChipGap}"
                                     Label="Favorites"
                                     IsActive="{Binding SearchFilter.FavoritesOnly}">
                    <controls:FilterChip.ChipContent>
                        <CheckBox VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  Content="Only"
                                  IsChecked="{Binding SearchFilter.FavoritesOnly, Mode=TwoWay}" />
                    </controls:FilterChip.ChipContent>
                </controls:FilterChip>

                <Button Margin="{DynamicResource Thickness.ResetGap}"
                        VerticalAlignment="Center"
                        Command="{Binding SearchFilter.ResetCommand}"
                        Content="Reset"
                        IsEnabled="{Binding SearchFilter.HasActiveSearchOrFilters}" />
            </StackPanel>
        </Grid>

        <controls:ProjectList Grid.Row="2"
                              Margin="{DynamicResource Thickness.ProjectListMargin}"
                              DataContext="{Binding ProjectList}"
                              ActiveSort="{Binding DataContext.SearchFilter.ActiveSort, RelativeSource={RelativeSource AncestorType=Window}}"
                              ResetCommand="{Binding DataContext.SearchFilter.ResetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              SortRequested="OnProjectSortRequested" />

        <Border Grid.Row="3"
                Padding="{DynamicResource Thickness.StatusPadding}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="↻"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBar.IsOperationActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding StatusBar.IsOperationActive}" Value="True" />
                                            <Condition Binding="{Binding StatusBar.AreAnimationsEnabled}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ActivityRotation"
                                                             Storyboard="{StaticResource Motion.ActivityRotationStoryboard}" />
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="ActivityRotation" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{DynamicResource Text.Secondary}"
                               Text="{Binding StatusBar.StatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Style="{DynamicResource Text.Secondary}"
                           Text="{Binding ProjectList.ShowingCountText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
