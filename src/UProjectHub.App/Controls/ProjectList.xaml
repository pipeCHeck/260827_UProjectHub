<UserControl x:Class="UProjectHub.App.Controls.ProjectList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:UProjectHub.App.Behaviors"
             xmlns:converters="clr-namespace:UProjectHub.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ProjectStateMessageConverter x:Key="ProjectStateMessageConverter" />
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />

        <ContextMenu x:Key="ProjectContextMenu"
                     x:Shared="False"
                     Background="{DynamicResource Brush.ElevatedSurface}"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     DataContext="{Binding PlacementTarget.DataContext.ContextActions, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource String.OpenProject}"
                      Command="{Binding OpenProjectCommand}" />
            <MenuItem Header="{DynamicResource String.OpenVisualStudio}"
                      Command="{Binding OpenInVisualStudioCommand}"
                      ToolTip="{Binding OpenInVisualStudioUnavailableReason}" />
            <MenuItem Header="{DynamicResource String.GenerateProjectFiles}"
                      Command="{Binding GenerateProjectFilesCommand}"
                      ToolTip="{Binding GenerateProjectFilesUnavailableReason}" />
            <MenuItem Header="{DynamicResource String.OpenFolder}"
                      Command="{Binding OpenProjectFolderCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource String.CopyPath}"
                      Command="{Binding CopyPathCommand}" />
            <MenuItem Header="{Binding ToggleFavoriteLabel}"
                      Command="{Binding ToggleFavoriteCommand}" />
            <Separator />
            <MenuItem Header="{DynamicResource String.ProjectDetails}"
                      Command="{Binding ProjectDetailsCommand}" />
            <MenuItem Header="{DynamicResource String.RemoveFromList}"
                      Command="{Binding RemoveFromListCommand}"
                      Visibility="{Binding CanRemoveFromList, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="ProjectDataGrid"
                  ItemsSource="{Binding Rows}"
                  Visibility="{Binding HasVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  behaviors:ResponsiveColumnsBehavior.IsEnabled="True"
                  behaviors:ResponsiveColumnsBehavior.ColumnLayout="{Binding ColumnLayout}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="{DynamicResource Metric.ProjectRowHeight}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnProjectDataGridMouseDoubleClick"
                  PreviewKeyDown="OnProjectDataGridPreviewKeyDown"
                  PreviewMouseLeftButtonDown="OnProjectDataGridPreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="OnProjectDataGridPreviewMouseRightButtonDown"
                  Sorting="OnSorting">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ContextMenu"
                            Value="{StaticResource ProjectContextMenu}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Button.Favorite}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ContextActions.ToggleFavoriteCommand}"
                                    Content="{Binding FavoriteGlyph}"
                                    ToolTip="{Binding ContextActions.ToggleFavoriteLabel}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{DynamicResource String.Project}"
                                        MinWidth="280"
                                        Width="*"
                                        CanUserSort="True"
                                        SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource Thickness.ListCellPadding}"
                                  VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding ProjectDirectory}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="{DynamicResource Thickness.WarningGap}"
                                               MaxWidth="320"
                                               VerticalAlignment="Center"
                                               Text="{Binding DiagnosticMessage}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DiagnosticMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiagnosticSeverity}" Value="Info">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiagnosticSeverity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{DynamicResource String.EngineVersion}"
                                    Width="145"
                                    MinWidth="135"
                                    CanUserSort="True"
                                    SortMemberPath="EngineVersion"
                                    ElementStyle="{StaticResource DataGrid.TextCellContent}"
                                    Binding="{Binding EngineDisplay}" />
                <DataGridTextColumn Header="{DynamicResource String.Type}"
                                    Width="105"
                                    MinWidth="90"
                                    CanUserSort="True"
                                    SortMemberPath="ProjectType"
                                    ElementStyle="{StaticResource DataGrid.TextCellContent}"
                                    Binding="{Binding TypeDisplay}" />
                <DataGridTextColumn Header="{DynamicResource String.LastModified}"
                                    Width="135"
                                    MinWidth="125"
                                    CanUserSort="True"
                                    SortMemberPath="LastModified"
                                    ElementStyle="{StaticResource DataGrid.TextCellContent}"
                                    Binding="{Binding LastModified, Converter={StaticResource RelativeTimeConverter}, ConverterParameter=CalendarDate}" />
                <DataGridTextColumn Header="{DynamicResource String.LastLaunched}"
                                    Width="135"
                                    MinWidth="125"
                                    CanUserSort="True"
                                    SortMemberPath="LastLaunched"
                                    ElementStyle="{StaticResource DataGrid.TextCellContent}"
                                    Binding="{Binding LastLaunched, Converter={StaticResource RelativeTimeConverter}}" />
                <DataGridTemplateColumn Header=""
                                        Width="48"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Button.Icon}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="⋮"
                                    ContextMenu="{StaticResource ProjectContextMenu}"
                                    Click="OnOverflowClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoProjectsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       Style="{DynamicResource Text.EmptyTitle}"
                       Text="{DynamicResource String.NoProjects}" />
            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{DynamicResource String.NoProjectsHint}" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       Style="{DynamicResource Text.EmptyTitle}"
                       Text="{DynamicResource String.NoResults}" />
            <Button Margin="{DynamicResource Thickness.EmptyActionGap}"
                    HorizontalAlignment="Center"
                    Command="{Binding ResetCommand, ElementName=Root}"
                    Content="{DynamicResource String.ResetSearchFilters}" />
        </StackPanel>
    </Grid>
</UserControl>
