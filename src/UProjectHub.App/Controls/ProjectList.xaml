<UserControl x:Class="UProjectHub.App.Controls.ProjectList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UProjectHub.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ProjectStateMessageConverter x:Key="ProjectStateMessageConverter" />
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="ProjectDataGrid"
                  ItemsSource="{Binding Rows}"
                  Visibility="{Binding HasVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="60"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Sorting="OnSorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="48" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding FavoriteGlyph}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Project"
                                        MinWidth="280"
                                        Width="*"
                                        CanUserSort="True"
                                        SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                               Text="{Binding ProjectDirectory}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                               Text="{Binding ProjectState, Converter={StaticResource ProjectStateMessageConverter}}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Engine"
                                    Width="120"
                                    CanUserSort="True"
                                    SortMemberPath="EngineVersion"
                                    Binding="{Binding EngineDisplay}" />
                <DataGridTextColumn Header="Type"
                                    Width="105"
                                    CanUserSort="True"
                                    SortMemberPath="ProjectType"
                                    Binding="{Binding TypeDisplay}" />
                <DataGridTextColumn Header="Last Modified"
                                    Width="135"
                                    CanUserSort="True"
                                    SortMemberPath="LastModified"
                                    Binding="{Binding LastModified, Converter={StaticResource RelativeTimeConverter}}" />
                <DataGridTextColumn Header="Last Launched"
                                    Width="135"
                                    CanUserSort="True"
                                    SortMemberPath="LastLaunched"
                                    Binding="{Binding LastLaunched, Converter={StaticResource RelativeTimeConverter}}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoProjectsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="No Unreal projects found." />
            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Add a project search root or rescan configured locations." />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="No projects match these filters." />
            <Button Margin="0,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    Command="{Binding ResetCommand, ElementName=Root}"
                    Content="Reset search and filters" />
        </StackPanel>
    </Grid>
</UserControl>
