<UserControl x:Class="UProjectHub.App.Controls.ProjectList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:UProjectHub.App.Behaviors"
             xmlns:converters="clr-namespace:UProjectHub.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ProjectStateMessageConverter x:Key="ProjectStateMessageConverter" />
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />

        <ContextMenu x:Key="ProjectContextMenu"
                     x:Shared="False"
                     Background="{DynamicResource Brush.ElevatedSurface}"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     DataContext="{Binding PlacementTarget.DataContext.ContextActions, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open Project"
                      Command="{Binding OpenProjectCommand}" />
            <MenuItem Header="Open in Visual Studio"
                      Command="{Binding OpenInVisualStudioCommand}" />
            <MenuItem Header="Open Folder"
                      Command="{Binding OpenProjectFolderCommand}" />
            <Separator />
            <MenuItem Header="Reveal .uproject"
                      Command="{Binding RevealProjectFileCommand}" />
            <MenuItem Header="Copy Path"
                      Command="{Binding CopyPathCommand}" />
            <MenuItem Header="{Binding ToggleFavoriteLabel}"
                      Command="{Binding ToggleFavoriteCommand}" />
            <Separator />
            <MenuItem Header="Project Information"
                      Command="{Binding ProjectInformationCommand}" />
            <MenuItem Header="Remove from List"
                      Command="{Binding RemoveFromListCommand}"
                      Visibility="{Binding CanRemoveFromList, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="ProjectDataGrid"
                  ItemsSource="{Binding Rows}"
                  Visibility="{Binding HasVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  behaviors:ResponsiveColumnsBehavior.IsEnabled="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="{DynamicResource Metric.ProjectRowHeight}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnProjectDataGridMouseDoubleClick"
                  PreviewKeyDown="OnProjectDataGridPreviewKeyDown"
                  PreviewMouseRightButtonDown="OnProjectDataGridPreviewMouseRightButtonDown"
                  Sorting="OnSorting">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ContextMenu"
                            Value="{StaticResource ProjectContextMenu}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="48" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Button.Icon}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ContextActions.ToggleFavoriteCommand}"
                                    Content="{Binding FavoriteGlyph}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Project"
                                        MinWidth="280"
                                        Width="*"
                                        CanUserSort="True"
                                        SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource Thickness.ListCellPadding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding ProjectDirectory}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="{DynamicResource Thickness.WarningGap}"
                                               Foreground="{DynamicResource Brush.WarningText}"
                                               Text="{Binding ProjectState, Converter={StaticResource ProjectStateMessageConverter}}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Engine"
                                    Width="120"
                                    MinWidth="110"
                                    CanUserSort="True"
                                    SortMemberPath="EngineVersion"
                                    Binding="{Binding EngineDisplay}" />
                <DataGridTextColumn Header="Type"
                                    Width="105"
                                    MinWidth="90"
                                    CanUserSort="True"
                                    SortMemberPath="ProjectType"
                                    Binding="{Binding TypeDisplay}" />
                <DataGridTextColumn Header="Last Modified"
                                    Width="135"
                                    MinWidth="125"
                                    CanUserSort="True"
                                    SortMemberPath="LastModified"
                                    Binding="{Binding LastModified, Converter={StaticResource RelativeTimeConverter}}" />
                <DataGridTextColumn Header="Last Launched"
                                    Width="135"
                                    MinWidth="125"
                                    CanUserSort="True"
                                    SortMemberPath="LastLaunched"
                                    Binding="{Binding LastLaunched, Converter={StaticResource RelativeTimeConverter}}" />
                <DataGridTemplateColumn Header=""
                                        Width="48"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Button.Icon}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="⋮"
                                    ContextMenu="{StaticResource ProjectContextMenu}"
                                    Click="OnOverflowClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoProjectsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       Style="{DynamicResource Text.EmptyTitle}"
                       Text="No Unreal projects found." />
            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Style="{DynamicResource Text.Secondary}"
                       Text="Add a project search root or rescan configured locations." />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       Style="{DynamicResource Text.EmptyTitle}"
                       Text="No projects match these filters." />
            <Button Margin="{DynamicResource Thickness.EmptyActionGap}"
                    HorizontalAlignment="Center"
                    Command="{Binding ResetCommand, ElementName=Root}"
                    Content="Reset search and filters" />
        </StackPanel>
    </Grid>
</UserControl>
