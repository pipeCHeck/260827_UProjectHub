<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ScrollBar.TrackButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadius.Small}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ScrollBar.VerticalTemplate" TargetType="ScrollBar">
        <Grid MinWidth="{DynamicResource Metric.ScrollBarThickness}"
              Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="{DynamicResource Metric.ScrollBarThumbMinimumLength}"
                           Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.HorizontalTemplate" TargetType="ScrollBar">
        <Grid MinHeight="{DynamicResource Metric.ScrollBarThickness}"
              Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="False"
                   Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="{DynamicResource Metric.ScrollBarThumbMinimumLength}"
                           Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource ScrollBar.TrackButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="MinWidth" Value="{DynamicResource Metric.ScrollBarThickness}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.VerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="{DynamicResource Metric.ScrollBarThickness}" />
                <Setter Property="Template" Value="{StaticResource ScrollBar.HorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
