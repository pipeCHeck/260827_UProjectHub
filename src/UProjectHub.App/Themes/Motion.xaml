<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Duration x:Key="Motion.FastDuration">0:0:0.09</Duration>
    <Duration x:Key="Motion.NormalDuration">0:0:0.14</Duration>
    <Duration x:Key="Motion.SlowDuration">0:0:0.18</Duration>
    <Duration x:Key="Motion.ActivityDuration">0:0:1</Duration>
    <sys:Boolean x:Key="Motion.AnimationsEnabled">True</sys:Boolean>
    <QuadraticEase x:Key="Motion.EaseOut" EasingMode="EaseOut" />
    <Storyboard x:Key="Motion.ActivityRotationStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0"
                         To="360"
                         Duration="0:0:1"
                         RepeatBehavior="Forever" />
    </Storyboard>
</ResourceDictionary>
